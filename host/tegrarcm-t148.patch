+#define RAWWRITE_SECTOR_SIZE 512
+
+/*
+ * raw_write(): custom command (opcode 5), not a real NVIDIA command - see
+ * analysis_artifacts/miniloaders/RAW_WRITE_PLAN.md. hardware_tested: false.
+ * Writes `filename` (must be an exact multiple of 512 bytes) directly to
+ * eMMC starting at 512-byte sector `sector`, talking only to our own
+ * patched miniloader's new handler - bypasses bct_acquire/bct_process/
+ * DL_BL/stage2 entirely. One nv3p DATA packet (512 bytes) per sector, each
+ * individually ACKed by the device inside its own receive loop. Does NOT
+ * call wait_status() - that waits for a real NV3P_CMD_STATUS exchange our
+ * simple device-side handler never sends (see RAW_WRITE_PLAN.md); our own
+ * handler instead sends a plain ACK for the command itself immediately,
+ * which is all nv3p_cmd_send()'s own internal nv3p_wait_ack() needs.
+ */
+static int raw_write(nv3p_handle_t h3p, char *filename, uint32_t sector)
+{
+	int ret;
+	int fd;
+	struct stat sb;
+	nv3p_cmd_raw_write_t arg;
+	uint8_t buf[RAWWRITE_SECTOR_SIZE];
+	uint32_t count, i;
+	ssize_t n;
+
+	fd = open(filename, O_RDONLY | O_BINARY, 0);
+	if (fd < 0) {
+		dprintf("error opening %s for reading\n", filename);
+		return errno;
+	}
+
+	if (fstat(fd, &sb)) {
+		dprintf("error on fstat of %s\n", filename);
+		close(fd);
+		return errno;
+	}
+
+	if (sb.st_size == 0 || (sb.st_size % RAWWRITE_SECTOR_SIZE) != 0) {
+		dprintf("%s size (%lld) is not an exact multiple of %d bytes\n",
+			filename, (long long)sb.st_size, RAWWRITE_SECTOR_SIZE);
+		close(fd);
+		return EINVAL;
+	}
+	count = (uint32_t)(sb.st_size / RAWWRITE_SECTOR_SIZE);
+
+	arg.sector = sector;
+	arg.count = count;
+
+	ret = nv3p_cmd_send(h3p, NV3P_CMD_RAW_WRITE, (uint8_t *)&arg);
+	if (ret) {
+		nv3p_platform_info_t info;
+		int ret2;
+		fprintf(stderr, "DIAG: raw write command failed (ret=%d), probing if device still responds to GET_PLATFORM_INFO...\n", ret);
+		ret2 = nv3p_cmd_send(h3p, NV3P_CMD_GET_PLATFORM_INFO, (uint8_t *)&info);
+		if (ret2) {
+			fprintf(stderr, "DIAG: probe nv3p_cmd_send FAILED (ret2=%d) - device is unresponsive to new commands\n", ret2);
+		} else {
+			fprintf(stderr, "DIAG: probe SUCCEEDED - device still alive and responding normally! Chip ID: 0x%x\n", (uint32_t)info.chip_id.id);
+		}
+		dprintf("error sending raw write command\n");
+		close(fd);
+		return ret;
+	}
+
+	/* sector/count sent as a separate 8-byte DATA packet, not as inline
+	 * command args - see the comment in nv3p.c's nv3p_write_cmd(). */
+	ret = nv3p_data_send(h3p, (uint8_t *)&arg, sizeof(arg));
+	if (ret) {
+		dprintf("error sending raw write metadata\n");
+		close(fd);
+		return ret;
+	}
+
+	for (i = 0; i < count; i++) {
+		n = read(fd, buf, RAWWRITE_SECTOR_SIZE);
+		if (n != RAWWRITE_SECTOR_SIZE) {
+			dprintf("short read on %s (sector %u)\n", filename, i);
+			close(fd);
+			return EIO;
+		}
+
+		ret = nv3p_data_send(h3p, buf, RAWWRITE_SECTOR_SIZE);
+		if (ret) {
+			dprintf("error sending sector %u (device sector %u)\n",
+				i, sector + i);
+			close(fd);
+			return ret;
+		}
+
+		printf("\rsector %u/%u (device sector %u) written",
+			i + 1, count, sector + i);
+		fflush(stdout);
+	}
+	printf("\n");
+
+	close(fd);
+	return 0;
+}
+
+/*
+ * raw_read(): custom command (opcode 0), not a real NVIDIA command - see
+ * analysis_artifacts/miniloaders/RAW_WRITE_PLAN.md. hardware_tested: false.
+ * Reads `count` 512-byte sectors starting at `sector` directly from eMMC
+ * into `filename`, via our own patched miniloader's new handler - added
+ * specifically to verify raw_write()'s own output, since stock
+ * nvflash/stage2 are both blocked by the same corrupted on-flash BCT this
+ * whole project exists because of (confirmed again this session).
+ */
+static int raw_read(nv3p_handle_t h3p, char *filename, uint32_t sector, uint32_t count)
+{
+	int ret;
+	int fd;
+	nv3p_cmd_raw_write_t arg; /* same {sector,count} shape for both commands */
+	uint8_t buf[RAWWRITE_SECTOR_SIZE];
+	uint32_t i;
+	ssize_t n;
+
+	if (count == 0) {
+		dprintf("--rawreadcount must be > 0\n");
+		return EINVAL;
+	}
+
+	fd = open(filename, O_WRONLY | O_CREAT | O_TRUNC | O_BINARY, 0644);
+	if (fd < 0) {
+		dprintf("error opening %s for writing\n", filename);
+		return errno;
+	}
+
+	arg.sector = sector;
+	arg.count = count;
+
+	ret = nv3p_cmd_send(h3p, NV3P_CMD_RAW_READ, (uint8_t *)&arg);
+	if (ret) {
+		nv3p_platform_info_t info;
+		int ret2;
+		fprintf(stderr, "DIAG: raw read command failed (ret=%d), probing if device still responds to GET_PLATFORM_INFO...\n", ret);
+		ret2 = nv3p_cmd_send(h3p, NV3P_CMD_GET_PLATFORM_INFO, (uint8_t *)&info);
+		if (ret2) {
+			fprintf(stderr, "DIAG: probe nv3p_cmd_send FAILED (ret2=%d) - device is unresponsive to new commands\n", ret2);
+		} else {
+			fprintf(stderr, "DIAG: probe SUCCEEDED - device still alive and responding normally! Chip ID: 0x%x\n", (uint32_t)info.chip_id.id);
+		}
+		dprintf("error sending raw read command\n");
+		close(fd);
+		return ret;
+	}
+
+	/* sector/count sent as a separate 8-byte DATA packet, not as inline
+	 * command args - see the comment in nv3p.c's nv3p_write_cmd(). */
+	ret = nv3p_data_send(h3p, (uint8_t *)&arg, sizeof(arg));
+	if (ret) {
+		dprintf("error sending raw read metadata\n");
+		close(fd);
+		return ret;
+	}
+
+	for (i = 0; i < count; i++) {
+		ret = nv3p_data_recv(h3p, buf, RAWWRITE_SECTOR_SIZE);
+		if (ret) {
+			dprintf("error receiving sector %u (device sector %u)\n",
+				i, sector + i);
+			close(fd);
+			return ret;
+		}
+
+		n = write(fd, buf, RAWWRITE_SECTOR_SIZE);
+		if (n != RAWWRITE_SECTOR_SIZE) {
+			dprintf("short write to %s (sector %u)\n", filename, i);
+			close(fd);
+			return EIO;
+		}
+
+		printf("\rsector %u/%u (device sector %u) read",
+			i + 1, count, sector + i);
+		fflush(stdout);
+	}
+	printf("\n");
+
+	close(fd);
+	return 0;
+}
